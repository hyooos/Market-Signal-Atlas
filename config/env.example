TWELVE_DATA_API_KEY=
CRON_SECRET=replace-with-a-long-random-value
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BATCH_MODEL=gpt-5.4-nano
ENABLE_LIVE_AI=false

# Optional: enables the live reaction pipeline (src/lib/liveReaction.ts) and the
# /review human-review queue. Pulled automatically via `vercel env pull` once a
# KV/Upstash Redis store is connected to the project. Safe to leave unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
